# Example settings. Copy this file to .env for local development.
# .env is git-ignored on purpose: never commit real values or tokens.
# In production, set these in Vercel: Project → Settings → Environment Variables.

# Production address of the site (https only). Used for canonical/hreflang links,
# sitemap.xml and robots.txt. On Vercel it falls back to the production domain.
# SITE_URL=https://example.com

# Never-expiring Facebook Page access token (README, "Facebook news").
# Locally it's only needed to test the news import: `pnpm news`.
# FB_PAGE_TOKEN=

# Text returned by the example endpoint GET /api/ping.
PING_MESSAGE=ping
