{
  "name": "kolibri-website",
  "private": true,
  "type": "module",
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/fetch-facebook-news.mjs && vite build && vite build --ssr client/entry-server.tsx --outDir dist/prerender && node scripts/prerender.mjs",
    "build:client": "vite build",
    "news": "node scripts/fetch-facebook-news.mjs",
    "build:server": "vite build --config vite.config.server.ts",
    "build:vercel": "npm run build",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest --run",
    "format.fix": "prettier --write .",
    "typecheck": "tsc"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "serverless-http": "^3.2.0",
    "tailwind-merge": "^2.6.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "pnpm": {
    "overrides": {
      "yaml": "^2.8.3"
    }
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
